<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="author" content="Manguer Aya">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="styles.css">
  <link rel="stylesheet" href="styles.css">
  <meta name="description" content="The official pet adoptin website for Love at First Paws">
  <link rel="stylesheet" href="css/website_design.css">
  <script src="js/form_validation.js" defer></script>
  <title>Love At First Paws</title>
<body>
<%- include('partials/header') %>
<div class="grid">
    <div class="contentarea">
        <div class="contentarea2">
            <div class="div1_contentarea">
                <h2>Welcome to Love at First Paws!</h2>
                <p>
                    Discover the joy of pet adoption at Love at First Paws.
                     We connect loving families with cats and dogs in need of forever homes.
                     Find your perfect companion today!
                </p>
            </div>
            <div class="div2_contentarea">
                <h2>Our Mission</h2>
                <p>
                    At Love At First Paws, our journey began with a simple yet powerful mission:
                     to ensure that every cat and dog finds a loving home.
                     Our story is rooted in compassion, dedication, and a deep love for animals.<br>
                     Our Mission is to connect homeless cats and dogs with caring families.
                     We strive to make the adoption process simple, transparent, and rewarding for both the animals and their new owners.
                     Our goal is to reduce the number of pets in shelters, promote responsible pet ownership, and support the well-being of animals everywhere.
                </p>
            </div>
        </div>
        
        <div class="hp_header">
            <h1>Featured Pets</h1>
            <p>Meet some of our adorable and adoptable cats and dogs</p>
        </div>
        <div class="featuredpets">
            <div class="hp_rows">
                <div class="petname">
                    <img src="images/whiskers.jpg" alt="Image by Alexander London on https://unsplash.com/fr/s/photos/cat">
                    <div class="layers">
                       <h3>WHISKERS</h3> 
                    </div>
                </div>
                <div class="petname">
                    <img src="images/luna.jpg" alt="Image by Vivian Arcidiacono on https://unsplash.com/fr/s/photos/siamese-cat">
                    <div class="layers">
                       <h3>LUNA</h3> 
                    </div>
                </div>
                <div class="petname">
                    <img src="images/buddy.jpg" alt="Image by Max Sandelin on https://unsplash.com/fr/s/photos/golden-retriever" width= "225" >
                    <div class="layers">
                       <h3>BUDDY</h3> 
                    </div>
                </div>
            </div>
        </div>
    </div>
    <main >
        <div class="sidemenu">
            <nav class="sidemenu__ul">
                <h2><i class="fa fa-bars" ></i> Menu</h2>
                <ul class="sidemenu_ul">
                    <li>
                        <a href='/homepage'><i class="fa fa-home" ></i><p>Home page</p></a>
                    </li>
                    <li>
                      <a href="/createaccount"><i class='fas fa-user-plus' ></i><p>Create An account</p></a>
                  </li>
                    <li>
                        <a href="/login"><i class="fa fa-sign-in" ></i><p>Log In</p></a>
                    </li>
                    <li>
                        <a href='/findadogcat'><i class="fa fa-list-alt" ></i><p>Find a Dog/Cat</p></a>
                    </li>
                    <li>
                        <a href='/petcare'><i class="fa fa-paw"></i><p>Dog/Cat Care</p></a>
                    </li>
                    <li>
                        <a href='/haveapettogiveaway'><i class="fa fa-gift" ></i><p>Have a Pet to Give Away</p></a>
                    </li>
                    <li>
                        <a href='/contactus'><i class="fa fa-mobile" ></i><p>Contact Us</p></a>
                    </li>
                    <li>
                        <a href="/logout"><i class="fa fa-sign-out" ></i><p>Log Out</p></a>
                    </li>
                </ul>
            </nav>
        </div> 
    </main>  
</div>
<%- include('partials/footer') %>
<script src="js/dateTime.js"></script>
</body>
</html>