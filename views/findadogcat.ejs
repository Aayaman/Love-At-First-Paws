<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="author" content="Manguer Aya">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="styles.css">
  <link rel="stylesheet" href="styles.css">
  <meta name="description" content="The official pet adoptin website for Love at First Paws">
  <link rel="stylesheet" href="css/website_design.css">
  <script src="js/form_validation.js" defer></script>
  <title>Find A Dog/Cat</title>
<body>
<%- include('partials/header') %>
<div class="grid">
    <div class="cont_giveapet">
        <h1 class="giveapet_h1">Find a Dog/Cat</h1>
        <% if (success_msg) { %>
            <h3 class="alert alert-success"><%= success_msg %></h3>
        <% } %>
        <% if (error_msg) { %>
            <h3 class="alert alert-danger"><%= error_msg %></h3>
        <% } %>
        <% if (info_msg) { %>
            <h3 class="alert alert-info"><%= info_msg %></h3>
        <% } %>
        <form action="/findadogcat" method="POST" class="give">
            <div   class="give_h3"><h3>Pet's requirements</h3></div>
            <div class="give1">
                <div class="form">
                    <label for="pet_type">Select Pet Type </label>
                    <select id="pet_type" name="pet_type">
                        <option value="cat">Cat</option>
                        <option value="dog">Dog</option>
                    </select>
                </div>
                <div class="form">
                    <label for="cat_breed">Preferred Cat Breed:</label>
                    <select id= "cat_breed" name="cat_breed">
                        <option value="Abyssinian">Abyssinian</option>
                        <option value="American Shorthair">American Shorthair</option>
                        <option value="Bengal">Bengal</option>
                        <option value="British Shorthair">British Shorthair</option>
                        <option value="Maine Coon">Maine Coon</option>
                        <option value="Persian">Persian</option>
                        <option value="Ragdoll">Ragdoll</option>
                        <option value="Siamese">Siamese</option>
                        <option value="Sphynx">Sphynx</option>
                        <option value="Tabby">Tabby</option>
                        <option value="Russian Blue">Russian Blue</option>
                        <option value="Doesn't matter">Doesn't matter</option>
                    </select>
                </div>
                <div class="form">
                    <label for="dog_breed">Preferred Dog Breed:</label>
                    <select id= "dog_breed" name="dog_breed">
                        <option value="Labrador Retriever">Labrador Retriever</option>
                        <option value="German Shepherd">German Shepherd</option>
                        <option value="Golden Retriever">Golden Retriever</option>
                        <option value="French Bulldog">French Bulldog</option>
                        <option value="Bulldog">Bulldog</option>
                        <option value="Poodle">Poodle</option>
                        <option value="Beagle">Beagle</option>
                        <option value="Boxer">Boxer</option>
                        <option value="Dachshund">Dachshund</option>
                        <option value="Siberian Husky">Siberian Husky</option>
                        <option value="Chihuahua">Chihuahua</option>
                        <option value="Shih Tzu">Shih Tzu</option>
                        <option value="Mixed Breed">Mixed Breed</option>
                        <option value="Doesn't matter">Doesn't matter</option> 
                    </select>
                </div>
                <div class="form">
                    <label for="age">Preferred Age:</label>
                    <select id="age"  name="age" >
                        <option value="Puppy/Kitten">Puppy/Kitten</option>
                        <option value="Young (1-3 years)">Young (1-3 years)</option>
                        <option value="Adult (4-7 years)">Adult (4-7 years)</option>
                        <option value="Senior (8+ years)">Senior (8+ years)</option>
                        <option value="Doesn't matter">Doesn't matter</option>
                    </select>
                </div>
            </div>
           
            <div class="g">
                <p>
                    Select Gender
                    <label for="male"> Male</label>
                    <input type ="radio" id="male" name="gender" value="male">
                    <label for="female"> Female</label>
                    <input type ="radio" id="female" name="gender" value="female">
                    <label for="matter"> Doesn't matter</label>
                    <input type ="radio" id="matter" name="gender" value="Doesn't matter">
                </p>
            </div>
            <div class="g">
                <p>
                Gets along with others dogs?
                <label for="yes1"> Yes</label>
                <input type ="radio" id="yes1" name="friendly1" value="yes">
                <label for="no1"> No</label>
                <input type ="radio" id="no1" name="friendly1" value="no"> 
                </p>
            </div>
            <div class="g">
                <p>
                Gets along with others cats?
                <label for="yes2"> Yes</label>
                <input type ="radio" id="yes2" name="friendly2" value="yes">
                <label for="no2"> No</label>
                <input type ="radio" id="no2" name="friendly2" value="no">
                </p>
            </div>
            <div class="g">
                <p>
                Suitable for a family with small children?
                <label for="yes3"> Yes</label>
                <input type ="radio" id="yes3" name="friendly3" value="yes">
                <label for="no3"> No</label>
                <input type ="radio" id="no3" name="friendly3" value="no">
                </p>
            </div>
            <div class="g">
                <div class="g1">
                    <button type="submit"> Submit </button>
                    <button type="reset"> Clear </button>
                </div>
            </div>
        </form>
        <% if (pets.length > 0) { %>
            <h3 class="alert_no">These Are The Available Pets</h3>
            <ul class="alert_no">
                <% pets.forEach(pet => { 
                    const petData = pet.split(':');
                    const petType = petData[2];
                    const catBreed = petData[3];
                    const dogBreed = petData[4];
                    const age = petData[5];
                    const gender = petData[6];
                    const friendlyWithDogs = petData[7] === 'yes' ? 'yes' : 'no';
                    const friendlyWithCats = petData[8] === 'yes' ? 'yes' : 'no';
                    const suitableForChildren = petData[9] === 'yes' ? 'yes' : 'no';
                %>
                    <li class="alert_li">
                        <p>Pet type: <%= petType %></p>
                        <% if (petType === 'dog') { %>
                            <p>Dog breed: <%= dogBreed %></p>
                        <% } else { %>
                            <p>Cat breed: <%= catBreed %></p>
                        <% } %>
                        <p>Age: <%= age %></p>
                        <p>Gender: <%= gender %></p>
                        <p>Friendly with dogs: <%= friendlyWithDogs %></p>
                        <p>Friendly with cats: <%= friendlyWithCats %></p>
                        <p>Suitable for a family with pets: <%= suitableForChildren %></p>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p class="alert">No pets found matching your criteria.</p>
        <% } %>
    </div>
    <main >
        <div class="sidemenu">
            <nav class="sidemenu__ul">
                <h2><i class="fa fa-bars" ></i> Menu</h2>
                <ul class="sidemenu_ul">
                    <li>
                        <a href='/homepage'><i class="fa fa-home" ></i><p>Home page</p></a>
                    </li>
                    <li>
                      <a href="/createaccount"><i class='fas fa-user-plus' ></i><p>Create An account</p></a>
                  </li>
                    <li>
                        <a href="/login"><i class="fa fa-sign-in" ></i><p>Log In</p></a>
                    </li>
                    <li>
                        <a href='/findadogcat'><i class="fa fa-list-alt" ></i><p>Find a Dog/Cat</p></a>
                    </li>
                    <li>
                        <a href='/petcare'><i class="fa fa-paw"></i><p>Dog/Cat Care</p></a>
                    </li>
                    <li>
                        <a href='/haveapettogiveaway'><i class="fa fa-gift" ></i><p>Have a Pet to Give Away</p></a>
                    </li>
                    <li>
                        <a href='/contactus'><i class="fa fa-mobile" ></i><p>Contact Us</p></a>
                    </li>
                    <li>
                        <a href="/logout"><i class="fa fa-sign-out" ></i><p>Log Out</p></a>
                    </li>
                </ul>
            </nav>
        </div> 
    </main>
</div>
<%- include('partials/footer') %>
<script src="js/dateTime.js"></script>
</body>
</html>